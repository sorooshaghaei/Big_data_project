# Copy this file to `.env` and fill in your PostgreSQL server settings.
# Then load it into your shell before running scripts:
#   cp .env.example .env
#   set -a; source .env; set +a

PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=transport
PGUSER=your-postgres-user
PGPASSWORD=your-postgres-password
PGSCHEMA=transport
